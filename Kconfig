DT_COMPAT_ZPT_TELEMETRY := measlesbagel,zpt-telemetry
DT_COMPAT_ZPT_ROUTER := measlesbagel,zpt-router
DT_COMPAT_ZPT_DEVICE_TABLE := measlesbagel,zpt-pointing-device
DT_COMPAT_ZPT_ROUTE_BEHAVIOR := measlesbagel,zpt-behavior-route
DT_COMPAT_ZPT_COMPACT_SPLIT_ENCODER := measlesbagel,zpt-input-processor-compact-split-encoder

menu "ZMK Pointing Tools"

config ZMK_POINTING_TOOLS_PIPELINE
    bool "Composable motion pipeline boundary"
    default $(dt_compat_enabled,$(DT_COMPAT_ZPT_ROUTER))
    depends on ZMK_POINTING
    depends on INPUT_MODE_THREAD
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
    help
      Reconstruct synchronized X/Y frames with source identity, transport, and
      CPI metadata; route them through ordered devicetree pipeline
      compositions; apply explicit enter/leave lifecycle on ZMK layer changes;
      schedule stateful-stage deadlines; and emit terminal output through the
      router's virtual input device. Cursor, scroll, and text pipelines share
      the same estimator, constraint, transfer, quantizer, and batching
      stages, with a keypress suppression guard participating in every
      pass/buffer/drop decision.

config ZMK_POINTING_TOOLS_ROUTE_BEHAVIOR
    bool "Momentary pointing pipeline route behavior"
    default $(dt_compat_enabled,$(DT_COMPAT_ZPT_ROUTE_BEHAVIOR))
    depends on ZMK_POINTING_TOOLS_PIPELINE
    help
      Select a named router pipeline while a behavior binding is held, then
      restore the newest remaining explicit override or the active layer route.

config ZMK_POINTING_TOOLS_ROUTER_MAX_EXPLICIT_ROUTES
    int "Maximum simultaneous explicit routes per pointing router"
    default 4
    range 1 16
    depends on ZMK_POINTING_TOOLS_PIPELINE

config ZMK_POINTING_TOOLS_DEVICE_TABLE
    bool "Physical pointing device discovery table"
    default $(dt_compat_enabled,$(DT_COMPAT_ZPT_DEVICE_TABLE))
    depends on ZMK_POINTING
    help
      Describe physical pointing devices independently of pipelines and
      tuning targets: stable cross-half identities, owning split half, and
      supported CPI capabilities. Discovery, preview, and split-routed
      sensor control build on this table.

config ZMK_POINTING_TOOLS_COMPACT_SPLIT_CODEC
    bool
    default y if ZMK_POINTING_TOOLS_PIPELINE || ZMK_POINTING_TOOLS_COMPACT_SPLIT_ENCODER

config ZMK_POINTING_TOOLS_COMPACT_SPLIT_ENCODER
    bool "Compact complete-frame split transport encoder"
    default $(dt_compat_enabled,$(DT_COMPAT_ZPT_COMPACT_SPLIT_ENCODER))
    depends on ZMK_POINTING
    help
      Encode one complete signed X/Y frame into one split input event on a
      peripheral. A composable central-side pipeline ingress provides the
      matching decoder with cadence and sequence diagnostics.

config ZMK_POINTING_TOOLS_TELEMETRY
    bool "USB serial pointing telemetry service"
    default $(dt_compat_enabled,$(DT_COMPAT_ZPT_TELEMETRY))
    depends on SERIAL
    depends on UART_INTERRUPT_DRIVEN
    help
      Expose state samples and discovery over a dedicated USB CDC-ACM serial
      interface.

if ZMK_POINTING_TOOLS_TELEMETRY

config ZMK_POINTING_TOOLS_RUNTIME_TUNING
    bool "Temporary runtime tuning over USB serial"
    default y
    help
      Discover targets and preview validated parameter changes. Runtime
      values are never persisted and return to devicetree defaults on reset
      or reboot.

if ZMK_POINTING_TOOLS_RUNTIME_TUNING

config ZMK_POINTING_TOOLS_TUNING_MAX_TARGETS
    int "Maximum runtime tuning targets"
    default 16
    range 1 32

config ZMK_POINTING_TOOLS_STATE_TELEMETRY
    bool "Semantic stage-state telemetry"
    default y
    help
      Optionally expose axis intent, suppression, accumulation, clipping, and
      gesture lifecycle decisions from observed pipeline stages. State
      telemetry remains off until requested by a connected host.

endif

config ZMK_POINTING_TOOLS_TELEMETRY_QUEUE_SIZE
    int "Maximum queued telemetry samples"
    default 64
    range 8 512

config ZMK_POINTING_TOOLS_TELEMETRY_THREAD_STACK_SIZE
    int "Telemetry worker stack size"
    default 1536
    range 1024 4096

config ZMK_POINTING_TOOLS_TELEMETRY_HOST_TIMEOUT_MS
    int "Host heartbeat timeout"
    default 5000
    range 1000 60000
    help
      Stop telemetry if the host disappears without disabling it cleanly.

endif

endmenu
