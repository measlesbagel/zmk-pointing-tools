DT_COMPAT_ZPT_TRACE := measlesbagel,zpt-input-processor-trace
DT_COMPAT_ZPT_TELEMETRY := measlesbagel,zpt-telemetry
DT_COMPAT_ZPT_SCROLL := measlesbagel,zpt-input-processor-scroll
DT_COMPAT_ZPT_NOISE_FILTER := measlesbagel,zpt-input-processor-noise-filter
DT_COMPAT_ZPT_ROUTER := measlesbagel,zpt-router
DT_COMPAT_ZPT_COMPACT_SPLIT_ENCODER := measlesbagel,zpt-input-processor-compact-split-encoder
DT_COMPAT_ZPT_TEXT_NAV := measlesbagel,zpt-input-processor-text-nav
DT_COMPAT_ZPT_SIGN_EXTEND_XY := measlesbagel,zpt-input-processor-sign-extend-xy

menu "ZMK Pointing Tools"

config ZMK_POINTING_TOOLS_TRACE
    bool "Pass-through pointing trace processor"
    default $(dt_compat_enabled,$(DT_COMPAT_ZPT_TRACE))
    depends on ZMK_POINTING
    help
      Observe complete relative-input frames without modifying their output.

config ZMK_POINTING_TOOLS_SCROLL
    bool "Frame-aware synchronized scroll processor"
    default $(dt_compat_enabled,$(DT_COMPAT_ZPT_SCROLL))
    depends on ZMK_POINTING
    help
      Coalesce complete X/Y frames and emit synchronized horizontal and
      vertical scrolling with free, adaptive, or forced axis policies.

config ZMK_POINTING_TOOLS_NOISE_FILTER
    bool "Vector-aware dead-zone and noise filter"
    default $(dt_compat_enabled,$(DT_COMPAT_ZPT_NOISE_FILTER))
    depends on ZMK_POINTING
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
    help
      Buffer idle vectors until coherent radial movement qualifies, then pass
      the complete gesture without per-axis bias or lost distance.

config ZMK_POINTING_TOOLS_PIPELINE
    bool "Composable motion pipeline boundary"
    default $(dt_compat_enabled,$(DT_COMPAT_ZPT_ROUTER))
    depends on ZMK_POINTING
    depends on INPUT_MODE_THREAD
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
    help
      Reconstruct synchronized X/Y frames with source identity, transport, and
      CPI metadata; route it through ordered devicetree pipeline compositions;
      apply explicit enter/leave lifecycle on ZMK layer changes; schedule
      stateful-stage deadlines; and emit terminal cursor output through the
      router's virtual input device. The only terminal sink currently provided
      is cursor output.

config ZMK_POINTING_TOOLS_MOTION_GATE_CORE
    bool
    default y if ZMK_POINTING_TOOLS_PIPELINE || ZMK_POINTING_TOOLS_NOISE_FILTER

config ZMK_POINTING_TOOLS_COMPACT_SPLIT_CODEC
    bool
    default y if ZMK_POINTING_TOOLS_PIPELINE || ZMK_POINTING_TOOLS_COMPACT_SPLIT_ENCODER

config ZMK_POINTING_TOOLS_COMPACT_SPLIT_ENCODER
    bool "Compact complete-frame split transport encoder"
    default $(dt_compat_enabled,$(DT_COMPAT_ZPT_COMPACT_SPLIT_ENCODER))
    depends on ZMK_POINTING
    help
      Encode one complete signed X/Y frame into one split input event on a
      peripheral. A composable central-side pipeline ingress provides the
      matching decoder with cadence and sequence diagnostics.

config ZMK_POINTING_TOOLS_TEXT_NAV
    bool "Gesture-locked text navigation processor"
    default $(dt_compat_enabled,$(DT_COMPAT_ZPT_TEXT_NAV))
    depends on ZMK_POINTING
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
    help
      Convert complete relative movement gestures into directional behavior
      taps while retaining one axis until the gesture becomes idle.

config ZMK_POINTING_TOOLS_SIGN_EXTEND_XY
    bool "Sign-extend packed split X/Y values"
    default $(dt_compat_enabled,$(DT_COMPAT_ZPT_SIGN_EXTEND_XY))
    depends on ZMK_POINTING
    help
      Restore negative signed 16-bit relative axes after unpacking a combined
      split-transport event that represented its fields as unsigned values.

config ZMK_POINTING_TOOLS_TELEMETRY
    bool "USB serial pointing telemetry service"
    default $(dt_compat_enabled,$(DT_COMPAT_ZPT_TELEMETRY))
    depends on ZMK_POINTING_TOOLS_TRACE
    depends on SERIAL
    depends on UART_INTERRUPT_DRIVEN
    help
      Expose trace streams over a dedicated USB CDC-ACM serial interface.

if ZMK_POINTING_TOOLS_TELEMETRY

config ZMK_POINTING_TOOLS_RUNTIME_TUNING
    bool "Temporary runtime tuning over USB serial"
    default y
    depends on ZMK_POINTING_TOOLS_SCROLL || ZMK_POINTING_TOOLS_TEXT_NAV || ZMK_POINTING_TOOLS_NOISE_FILTER
    help
      Discover semantic processors and preview validated parameter changes.
      Runtime values are never persisted and return to devicetree defaults on
      reset or reboot.

if ZMK_POINTING_TOOLS_RUNTIME_TUNING

config ZMK_POINTING_TOOLS_TUNING_MAX_TARGETS
    int "Maximum runtime tuning targets"
    default 8
    range 1 32

config ZMK_POINTING_TOOLS_STATE_TELEMETRY
    bool "Semantic processor-state telemetry"
    default y
    help
      Optionally expose axis intent, suppression, accumulation, clipping, and
      gesture lifecycle decisions. State telemetry remains off until requested
      by a connected host.

endif

config ZMK_POINTING_TOOLS_TELEMETRY_QUEUE_SIZE
    int "Maximum queued telemetry samples"
    default 64
    range 8 512

config ZMK_POINTING_TOOLS_TELEMETRY_THREAD_STACK_SIZE
    int "Telemetry worker stack size"
    default 1536
    range 1024 4096

config ZMK_POINTING_TOOLS_TELEMETRY_HOST_TIMEOUT_MS
    int "Host heartbeat timeout"
    default 5000
    range 1000 60000
    help
      Stop telemetry if the host disappears without disabling it cleanly.

endif

endmenu
