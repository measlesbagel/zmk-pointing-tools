#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    zpt_test_keypress_guard: zpt_test_keypress_guard {
        compatible = "measlesbagel,zpt-keypress-suppression";
        suppress-after-keypress-ms = <40>;
    };

    /* Normalized cursor pipeline: counts to Q16 millimetres, motion gate,
     * base gain, and sub-pixel quantizer. */
    zpt_test_resolution_normalize: zpt_test_resolution_normalize {
        compatible = "measlesbagel,zpt-stage-resolution-normalize";
        stable-id = "resolution-normalize";
    };

    zpt_test_motion_gate: zpt_test_motion_gate {
        compatible = "measlesbagel,zpt-stage-coherent-displacement";
        stable-id = "motion-gate";
        enabled;
        activation-distance-micrometers = <220>;
        coherence-percent = <60>;
        qualification-timeout-ms = <160>;
        idle-timeout-ms = <120>;
    };

    zpt_test_cursor_transfer: zpt_test_cursor_transfer {
        compatible = "measlesbagel,zpt-stage-cursor-transfer";
        stable-id = "cursor-transfer";
        scale-multiplier = <1>;
        scale-divisor = <1>;
    };

    zpt_test_cursor_quantizer: zpt_test_cursor_quantizer {
        compatible = "measlesbagel,zpt-stage-cursor-quantizer";
        stable-id = "cursor-quantizer";
        units-per-meter = <27559>;
    };

    zpt_test_cursor_sink: zpt_test_cursor_sink {
        compatible = "measlesbagel,zpt-sink-cursor";
        stable-id = "cursor";
    };

    zpt_test_cursor_pipeline: zpt_test_cursor_pipeline {
        compatible = "measlesbagel,zpt-pipeline";
        stable-id = "test-cursor";
        stages = <&zpt_test_resolution_normalize &zpt_test_motion_gate
                  &zpt_test_cursor_transfer &zpt_test_cursor_quantizer>;
        sink = <&zpt_test_cursor_sink>;
    };

    /* Scroll pipeline: the same estimator and constraint over normalized
     * motion with a steps-per-metre transfer and a wheel sink. */
    zpt_test_scroll_resolution_normalize: zpt_test_scroll_resolution_normalize {
        compatible = "measlesbagel,zpt-stage-resolution-normalize";
        stable-id = "scroll-resolution-normalize";
    };

    zpt_test_scroll_axis_intent: zpt_test_scroll_axis_intent {
        compatible = "measlesbagel,zpt-stage-axis-intent";
        stable-id = "scroll-axis-intent";
        policy = <1>;
        engage-ratio-percent = <300>;
        release-ratio-percent = <180>;
        activation-distance-micrometers = <581>;
        window-ms = <64>;
        idle-timeout-ms = <120>;
        suppression = <&zpt_test_keypress_guard>;
    };

    zpt_test_scroll_constraint: zpt_test_scroll_constraint {
        compatible = "measlesbagel,zpt-stage-axis-constraint";
        stable-id = "scroll-constraint";
        discard-unclassified;
        idle-timeout-ms = <120>;
        fold-interval-ms = <16>;
        suppression = <&zpt_test_keypress_guard>;
    };

    zpt_test_scroll_batcher: zpt_test_scroll_batcher {
        compatible = "measlesbagel,zpt-stage-scroll-batcher";
        stable-id = "scroll-batcher";
        steps-per-meter = <3445>;
        report-interval-ms = <16>;
        suppression = <&zpt_test_keypress_guard>;
    };

    zpt_test_scroll_sink: zpt_test_scroll_sink {
        compatible = "measlesbagel,zpt-sink-scroll";
        stable-id = "scroll";
    };

    zpt_test_scroll_pipeline: zpt_test_scroll_pipeline {
        compatible = "measlesbagel,zpt-pipeline";
        stable-id = "test-scroll";
        stages = <&zpt_test_scroll_resolution_normalize &zpt_test_scroll_axis_intent
                  &zpt_test_scroll_constraint &zpt_test_scroll_batcher>;
        sink = <&zpt_test_scroll_sink>;
    };

    /* Text pipeline: gesture thresholds over normalized motion emitting
     * action taps. */
    zpt_test_text_resolution_normalize: zpt_test_text_resolution_normalize {
        compatible = "measlesbagel,zpt-stage-resolution-normalize";
        stable-id = "text-resolution-normalize";
    };

    zpt_test_composed_text_nav: zpt_test_composed_text_nav {
        compatible = "measlesbagel,zpt-stage-text-nav";
        stable-id = "text-nav";
        horizontal-threshold-micrometers = <2721>;
        vertical-threshold-micrometers = <2721>;
        idle-timeout-ms = <40>;
        activation-distance-micrometers = <1270>;
        engage-ratio-percent = <150>;
    };

    zpt_test_action_sink: zpt_test_action_sink {
        compatible = "measlesbagel,zpt-sink-action";
        stable-id = "text";
        bindings = <&kp LEFT>, <&kp RIGHT>, <&kp UP>, <&kp DOWN>;
        tap-ms = <5>;
    };

    zpt_test_text_pipeline: zpt_test_text_pipeline {
        compatible = "measlesbagel,zpt-pipeline";
        stable-id = "test-text";
        stages = <&zpt_test_text_resolution_normalize &zpt_test_composed_text_nav>;
        sink = <&zpt_test_action_sink>;
    };

    zpt_test_cursor_router: zpt_test_cursor_router {
        compatible = "measlesbagel,zpt-router";
        stable-id = "test-cursor-router";
        pipelines = <&zpt_test_cursor_pipeline &zpt_test_scroll_pipeline &zpt_test_text_pipeline>;
        default-pipeline = <&zpt_test_cursor_pipeline>;

        test-layer-route {
            /* Layer 0 is the only keymap layer; the route stays within range
             * and always selects the smoke cursor pipeline. */
            layers = <0>;
            pipeline = <&zpt_test_cursor_pipeline>;
        };
    };

    zpt_test_cursor_route: zpt_test_cursor_route {
        compatible = "measlesbagel,zpt-behavior-route";
        #binding-cells = <0>;
        router = <&zpt_test_cursor_router>;
        pipeline = <&zpt_test_cursor_pipeline>;
    };

    zpt_test_scroll_route: zpt_test_scroll_route {
        compatible = "measlesbagel,zpt-behavior-route";
        #binding-cells = <0>;
        router = <&zpt_test_cursor_router>;
        pipeline = <&zpt_test_scroll_pipeline>;
    };

    zpt_test_text_route: zpt_test_text_route {
        compatible = "measlesbagel,zpt-behavior-route";
        #binding-cells = <0>;
        router = <&zpt_test_cursor_router>;
        pipeline = <&zpt_test_text_pipeline>;
    };

    zpt_test_cursor_output: zpt_test_cursor_output {
        compatible = "zmk,input-listener";
        device = <&zpt_test_cursor_router>;
    };

    /* Compile both ends of the optional split codec and a compact-side
     * normalized cursor path without routing live motion through it. */
    zpt_test_compact_encoder: zpt_test_compact_encoder {
        compatible = "measlesbagel,zpt-input-processor-compact-split-encoder";
        #input-processor-cells = <0>;
        event-code = <INPUT_REL_Z>;
    };

    zpt_test_compact_resolution_normalize: zpt_test_compact_resolution_normalize {
        compatible = "measlesbagel,zpt-stage-resolution-normalize";
        stable-id = "compact-resolution-normalize";
    };

    zpt_test_compact_transfer: zpt_test_compact_transfer {
        compatible = "measlesbagel,zpt-stage-cursor-transfer";
        stable-id = "compact-transfer";
        scale-multiplier = <1>;
        scale-divisor = <1>;
    };

    zpt_test_compact_quantizer: zpt_test_compact_quantizer {
        compatible = "measlesbagel,zpt-stage-cursor-quantizer";
        stable-id = "compact-quantizer";
        units-per-meter = <27559>;
    };

    zpt_test_compact_sink: zpt_test_compact_sink {
        compatible = "measlesbagel,zpt-sink-cursor";
        stable-id = "compact-cursor";
    };

    zpt_test_compact_pipeline: zpt_test_compact_pipeline {
        compatible = "measlesbagel,zpt-pipeline";
        stable-id = "test-compact-cursor";
        stages = <&zpt_test_compact_resolution_normalize &zpt_test_compact_transfer
                  &zpt_test_compact_quantizer>;
        sink = <&zpt_test_compact_sink>;
    };

    zpt_test_compact_router: zpt_test_compact_router {
        compatible = "measlesbagel,zpt-router";
        stable-id = "test-compact-router";
        pipelines = <&zpt_test_compact_pipeline>;
        default-pipeline = <&zpt_test_compact_pipeline>;
    };

    zpt_test_compact_output: zpt_test_compact_output {
        compatible = "zmk,input-listener";
        device = <&zpt_test_compact_router>;
    };

    zpt_telemetry {
        compatible = "measlesbagel,zpt-telemetry";
    };

    zpt_telemetry_pipeline {
        compatible = "measlesbagel,zpt-pipeline-telemetry";
        pipelines = <&zpt_test_cursor_pipeline &zpt_test_scroll_pipeline &zpt_test_text_pipeline>;
    };

    chosen {
        measlesbagel,zpt-telemetry-uart = &zpt_acm;
    };

    keymap {
        compatible = "zmk,keymap";
        base {
            bindings = <
                &zpt_test_cursor_route &zpt_test_scroll_route &zpt_test_text_route &none &none &none   &none &none &none &none &none &none
                &none &none &none &none &none &none   &none &none &none &none &none &none
                &none &none &none &none &none &none   &none &none &none &none &none &none
                                  &none &none &none   &none &none &none
            >;
        };
    };
};

&zephyr_udc0 {
    zpt_acm: zpt_acm {
        compatible = "zephyr,cdc-acm-uart";
    };
};
