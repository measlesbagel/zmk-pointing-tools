#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    zpt_test_raw: zpt_test_raw {
        compatible = "measlesbagel,zpt-input-processor-trace";
        #input-processor-cells = <0>;
        pointing-device-id = <1>;
        stage = <0>;
        label = "Test raw";
    };

    zpt_test_output: zpt_test_output {
        compatible = "measlesbagel,zpt-input-processor-trace";
        #input-processor-cells = <0>;
        pointing-device-id = <1>;
        stage = <1>;
        label = "Test output";
    };

    zpt_test_orientation: zpt_test_orientation {
        compatible = "measlesbagel,zpt-stage-orientation";
        stable-id = "orientation";
    };

    zpt_test_pointer_identity: zpt_test_pointer_identity {
        compatible = "measlesbagel,zpt-stage-raw-pointer-identity";
        stable-id = "raw-pointer-identity";
    };

    zpt_test_cursor_sink: zpt_test_cursor_sink {
        compatible = "measlesbagel,zpt-sink-cursor";
        stable-id = "cursor";
    };

    zpt_test_cursor_pipeline: zpt_test_cursor_pipeline {
        compatible = "measlesbagel,zpt-pipeline";
        stable-id = "test-cursor";
        stages = <&zpt_test_orientation &zpt_test_pointer_identity>;
        sink = <&zpt_test_cursor_sink>;
    };

    zpt_test_cursor_router: zpt_test_cursor_router {
        compatible = "measlesbagel,zpt-router";
        stable-id = "test-cursor-router";
        pipelines = <&zpt_test_cursor_pipeline>;
        default-pipeline = <&zpt_test_cursor_pipeline>;

        test-layer-route {
            layers = <1>;
            pipeline = <&zpt_test_cursor_pipeline>;
        };
    };

    zpt_test_cursor_source: zpt_test_cursor_source {
        compatible = "measlesbagel,zpt-input-processor-source";
        #input-processor-cells = <0>;
        source-id = <1>;
        resolution-cpi = <700>;
        router = <&zpt_test_cursor_router>;
    };

    zpt_test_cursor_output: zpt_test_cursor_output {
        compatible = "zmk,input-listener";
        device = <&zpt_test_cursor_router>;
        input-processors = <&zpt_test_output>;
    };

    /* Compile both ends of the optional split codec without routing the test
     * noise device through this otherwise inactive smoke path. */
    zpt_test_compact_encoder: zpt_test_compact_encoder {
        compatible = "measlesbagel,zpt-input-processor-compact-split-encoder";
        #input-processor-cells = <0>;
        event-code = <INPUT_REL_Z>;
    };

    zpt_test_compact_orientation: zpt_test_compact_orientation {
        compatible = "measlesbagel,zpt-stage-orientation";
        stable-id = "orientation";
    };

    zpt_test_compact_pointer_identity: zpt_test_compact_pointer_identity {
        compatible = "measlesbagel,zpt-stage-raw-pointer-identity";
        stable-id = "raw-pointer-identity";
    };

    zpt_test_compact_sink: zpt_test_compact_sink {
        compatible = "measlesbagel,zpt-sink-cursor";
        stable-id = "cursor";
    };

    zpt_test_compact_pipeline: zpt_test_compact_pipeline {
        compatible = "measlesbagel,zpt-pipeline";
        stable-id = "test-compact-cursor";
        stages = <&zpt_test_compact_orientation &zpt_test_compact_pointer_identity>;
        sink = <&zpt_test_compact_sink>;
    };

    zpt_test_compact_router: zpt_test_compact_router {
        compatible = "measlesbagel,zpt-router";
        stable-id = "test-compact-router";
        pipelines = <&zpt_test_compact_pipeline>;
        default-pipeline = <&zpt_test_compact_pipeline>;
    };

    zpt_test_compact_source: zpt_test_compact_source {
        compatible = "measlesbagel,zpt-input-processor-source";
        #input-processor-cells = <0>;
        source-id = <2>;
        resolution-cpi = <700>;
        transported;
        compact-event-code = <INPUT_REL_Z>;
        compact-transport-coalesced;
        router = <&zpt_test_compact_router>;
    };

    zpt_test_compact_output: zpt_test_compact_output {
        compatible = "zmk,input-listener";
        device = <&zpt_test_compact_router>;
    };

    /* Instantiate normalized, stateful stage providers even though the
     * identity smoke path cannot yet terminate normalized motion. */
    zpt_test_resolution_normalize: zpt_test_resolution_normalize {
        compatible = "measlesbagel,zpt-stage-resolution-normalize";
        stable-id = "resolution-normalize";
    };

    zpt_test_motion_gate: zpt_test_motion_gate {
        compatible = "measlesbagel,zpt-stage-coherent-displacement";
        stable-id = "motion-gate";
        enabled;
        activation-distance-micrometers = <220>;
        coherence-percent = <60>;
        qualification-timeout-ms = <160>;
        idle-timeout-ms = <120>;
    };

    zpt_test_scroll: zpt_test_scroll {
        compatible = "measlesbagel,zpt-input-processor-scroll";
        #input-processor-cells = <1>;
        tuning-id = "test-scroll";
        tuning-label = "Test scroll";
        scale-multiplier = <1>;
        scale-divisor = <8>;
        report-interval-ms = <16>;
        idle-timeout-ms = <120>;
        intent-window-ms = <64>;
        activation-distance = <16>;
        engage-ratio-percent = <300>;
        release-ratio-percent = <180>;
        suppress-after-keypress-ms = <75>;
    };

    zpt_test_scroll_output: zpt_test_scroll_output {
        compatible = "zmk,input-listener";
        device = <&zpt_test_scroll>;
        input-processors = <&zpt_test_output>;
    };

    zpt_test_noise_filter: zpt_test_noise_filter {
        compatible = "measlesbagel,zpt-input-processor-noise-filter";
        #input-processor-cells = <0>;
        tuning-id = "test-noise-filter";
        tuning-label = "Test noise filter";
        enabled;
        activation-distance = <6>;
        coherence-percent = <60>;
        qualification-timeout-ms = <160>;
        idle-timeout-ms = <120>;
        suppress-after-keypress-ms = <40>;
    };

    zpt_test_noise_output: zpt_test_noise_output {
        compatible = "zmk,input-listener";
        device = <&zpt_test_noise_filter>;
        input-processors = <&zpt_test_raw &zpt_test_cursor_source>;
    };

    zpt_test_text_nav: zpt_test_text_nav {
        compatible = "measlesbagel,zpt-input-processor-text-nav";
        #input-processor-cells = <0>;
        tuning-id = "test-text-navigation";
        tuning-label = "Test text navigation";
        horizontal-threshold = <25>;
        vertical-threshold = <50>;
        bindings = <&kp LEFT>, <&kp RIGHT>, <&kp UP>, <&kp DOWN>;
        tap-ms = <5>;
        idle-timeout-ms = <120>;
        activation-distance = <12>;
        engage-ratio-percent = <150>;
    };

    zpt_test_sign_extend: zpt_test_sign_extend {
        compatible = "measlesbagel,zpt-input-processor-sign-extend-xy";
        #input-processor-cells = <0>;
    };

    zpt_telemetry {
        compatible = "measlesbagel,zpt-telemetry";
    };

    chosen {
        measlesbagel,zpt-telemetry-uart = &zpt_acm;
    };

    keymap {
        compatible = "zmk,keymap";
        base {
            bindings = <
                &none &none &none &none &none &none   &none &none &none &none &none &none
                &none &none &none &none &none &none   &none &none &none &none &none &none
                &none &none &none &none &none &none   &none &none &none &none &none &none
                                  &none &none &none   &none &none &none
            >;
        };
    };
};

&zephyr_udc0 {
    zpt_acm: zpt_acm {
        compatible = "zephyr,cdc-acm-uart";
    };
};
